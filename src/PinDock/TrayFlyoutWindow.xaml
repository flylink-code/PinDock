<Window x:Class="PinDock.TrayFlyoutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinDock 快捷浮窗" Width="378" Height="515"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" Topmost="True"
        AllowDrop="True" Drop="Window_Drop"
        Deactivated="Window_Deactivated" PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource PaperBrush}"
            BorderBrush="{DynamicResource LineBrush}"
            BorderThickness="1" CornerRadius="16" Margin="8" SnapsToDevicePixels="True">
        <Border.Effect>
            <DropShadowEffect BlurRadius="16" ShadowDepth="4" Opacity="0.24" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- 1. 顶部品牌、快捷切换（主题/语言）与即时搜索 -->
            <StackPanel Grid.Row="0" Margin="14,14,14,10">
                <DockPanel Margin="0,0,0,9">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock x:Name="FlyoutTitleText" Text="PinDock 快捷中心" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <Border Background="{DynamicResource SoftBrush}" CornerRadius="4" Padding="6,1.5" Margin="8,0,0,0" VerticalAlignment="Center">
                            <TextBlock x:Name="VersionBadgeText" Text="v0.1.1" FontSize="10" Foreground="{DynamicResource AccentBrush}"/>
                        </Border>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="HotkeyHintText" Text="Alt + Shift + P" VerticalAlignment="Center" FontSize="10.5" Margin="0,0,8,0" Foreground="{DynamicResource MutedBrush}"/>
                        <Button x:Name="BtnQuickTheme" Padding="7,3" Margin="0,0,4,0" Click="BtnQuickTheme_Click" ToolTip="快速切换亮色 / 暗色主题">
                            <TextBlock x:Name="TxtQuickTheme" Text="🌙" FontSize="11"/>
                        </Button>
                        <Button x:Name="BtnQuickLang" Padding="7,3" Click="BtnQuickLang_Click" ToolTip="切换中英文 (Switch Language)">
                            <TextBlock x:Name="TxtQuickLang" Text="EN" FontSize="10.5" FontWeight="SemiBold"/>
                        </Button>
                    </StackPanel>
                </DockPanel>
                <Border Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="10,6">
                    <Grid>
                        <TextBox x:Name="SearchBox" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource InkBrush}" CaretBrush="{DynamicResource InkBrush}"
                                 FontSize="12" VerticalContentAlignment="Center"
                                 TextChanged="SearchBox_TextChanged"/>
                        <TextBlock x:Name="SearchPlaceholder" Text="搜索收藏、文件夹或本机应用 (回车直接打开)…"
                                   Foreground="{DynamicResource MutedBrush}" FontSize="11.5"
                                   IsHitTestVisible="False" VerticalAlignment="Center"/>
                    </Grid>
                </Border>
            </StackPanel>

            <!-- 2. 快捷状态控制栏 -->
            <Border Grid.Row="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,0,14,10">
                <UniformGrid Columns="3">
                    <Button x:Name="BtnToggleDock" Margin="0,0,4,0" Padding="6,6" Click="BtnToggleDock_Click">
                        <TextBlock x:Name="TxtToggleDock" Text="Dock: 显示" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Button x:Name="BtnCycleMode" Margin="2,0,2,0" Padding="6,6" Click="BtnCycleMode_Click">
                        <TextBlock x:Name="TxtCycleMode" Text="模式: 常驻" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </Button>
                    <Button x:Name="BtnToggleLock" Margin="4,0,0,0" Padding="6,6" Click="BtnToggleLock_Click">
                        <TextBlock x:Name="TxtToggleLock" Text="位置: 可拖" FontSize="11" TextTrimming="CharacterEllipsis"/>
                    </Button>
                </UniformGrid>
            </Border>

            <!-- 3. 最近使用快捷栏 -->
            <Border x:Name="RecentSection" Grid.Row="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="14,8,14,9">
                <StackPanel>
                    <TextBlock x:Name="RecentHeaderText" Text="最近使用" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" Margin="0,0,0,6"/>
                    <WrapPanel x:Name="RecentPanel" Orientation="Horizontal"/>
                </StackPanel>
            </Border>

            <!-- 4. 分类切换标签栏 -->
            <Border Grid.Row="3" Padding="14,8,14,6">
                <StackPanel x:Name="TabPanel" Orientation="Horizontal"/>
            </Border>

            <!-- 5. 固定收藏与收藏组列表 -->
            <ScrollViewer Grid.Row="4" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="10,0,10,8">
                <StackPanel x:Name="ItemsListPanel"/>
            </ScrollViewer>

            <!-- 6. 底部工具栏 -->
            <Border Grid.Row="5" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="10,8,10,8" Background="{DynamicResource SoftBrush}" CornerRadius="0,0,15,15">
                <UniformGrid Columns="5">
                    <Button Margin="2,0" Padding="4,6" Click="BtnAdd_Click">
                        <TextBlock x:Name="TxtFooterAdd" Text="＋ 添加" FontSize="11"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,6" Click="BtnLibrary_Click">
                        <TextBlock x:Name="TxtFooterLib" Text="▦ 收藏库" FontSize="11"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,6" Click="BtnSettings_Click">
                        <TextBlock x:Name="TxtFooterSettings" Text="⚙ 设置" FontSize="11"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,6" Click="BtnUpdate_Click">
                        <TextBlock x:Name="TxtFooterUpdate" Text="↑ 更新" FontSize="11"/>
                    </Button>
                    <Button Margin="2,0" Padding="4,6" Click="BtnExit_Click">
                        <TextBlock x:Name="TxtFooterExit" Text="⏻ 退出" FontSize="11"/>
                    </Button>
                </UniformGrid>
            </Border>
        </Grid>
    </Border>
</Window>