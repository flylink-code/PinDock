<Window x:Class="PinDock.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="全部收藏" Width="780" Height="560" MinWidth="560" MinHeight="360"
        Background="{DynamicResource PaperBrush}" WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
    <DockPanel Margin="0">
        <DockPanel DockPanel.Dock="Top" Margin="24,20,24,0">
            <StackPanel>
                <TextBlock x:Name="TitleText" Text="全部收藏" FontSize="22" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock Text="收藏留在这里，常用的固定到 Dock" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,4,0,0"/>
            </StackPanel>
            <Button Content="×" Width="36" Height="36" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Top"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Click="Close_Click"/>
        </DockPanel>
        <StackPanel DockPanel.Dock="Top" Margin="24,14,24,0">
            <TextBox x:Name="SearchBox" Padding="9,8" FontSize="12" TextChanged="Filter_Changed"
                     Background="{DynamicResource SoftBrush}" BorderBrush="{DynamicResource LineBrush}"/>
            <WrapPanel Margin="0,10,0,0">
                <Button x:Name="FilterAll" Content="全部" Margin="0,0,7,7" Padding="10,7" Click="FilterButton_Click" Tag="all"/>
                <Button Content="应用" Margin="0,0,7,7" Padding="10,7" Click="FilterButton_Click" Tag="应用"/>
                <Button Content="文件夹" Margin="0,0,7,7" Padding="10,7" Click="FilterButton_Click" Tag="文件夹"/>
                <Button Content="文件" Margin="0,0,7,7" Padding="10,7" Click="FilterButton_Click" Tag="文件"/>
                <Button Content="＋ 添加收藏" Margin="0,0,7,7" Padding="10,7" Click="Add_Click"/>
                <Button Content="管理分组" Margin="0,0,7,7" Padding="10,7" Click="ManageGroups_Click"/>
                <Button Content="导入" Margin="0,0,7,7" Padding="10,7" Click="Import_Click"/>
                <Button Content="导出" Margin="0,0,7,7" Padding="10,7" Click="Export_Click"/>
            </WrapPanel>
        </StackPanel>
        <TextBlock x:Name="CountText" DockPanel.Dock="Bottom" Margin="24,8,24,16" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        <ListBox x:Name="ItemsList" Margin="20,8,20,0" BorderThickness="0" Background="Transparent"
                 VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="Open_Click">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <DockPanel Margin="3,8">
                        <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SoftBrush}" DockPanel.Dock="Left" Margin="0,0,12,0"
                                ToolTip="{Binding IconError}">
                            <Grid>
                                <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                <Image Source="{Binding Icon}" Width="24" Height="24"/>
                            </Grid>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Button Content="{Binding PinLabel}" Padding="8,6" Margin="0,0,6,0" Click="Pin_Click" Tag="{Binding}"/>
                            <Button Content="编辑" Padding="8,6" Margin="0,0,6,0" Click="Edit_Click" Tag="{Binding}"/>
                            <Button Content="移除" Padding="8,6" Click="Remove_Click" Tag="{Binding}"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding Bookmark.Name}" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"/>
                            <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </DockPanel>
</Window>
