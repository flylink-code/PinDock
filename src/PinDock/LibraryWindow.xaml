<local:CardWindowBase x:Class="PinDock.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PinDock"
        Title="全部收藏" Tag="收藏留在这里，常用的固定到 Dock" Width="812" Height="620"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
    <DockPanel>
        <!-- 搜索与筛选 -->
        <StackPanel DockPanel.Dock="Top" Margin="24,14,24,0">
            <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" AutomationProperties.Name="搜索全部收藏"/>
            <TextBlock x:Name="SearchHint" Text="搜索名称、路径或收藏组…" IsHitTestVisible="False" FontSize="12"
                       Foreground="{DynamicResource MutedBrush}" Margin="11,-27,0,0">
                <TextBlock.Style>
                    <Style TargetType="TextBlock">
                        <Setter Property="Visibility" Value="Collapsed"/>
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                <Setter Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
            <WrapPanel Margin="0,14,0,0">
                <RadioButton x:Name="FilterAll" Content="全部" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,7" Checked="FilterButton_Click" Tag="all"/>
                <RadioButton Content="应用" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,7" Checked="FilterButton_Click" Tag="应用"/>
                <RadioButton Content="文件夹" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,7" Checked="FilterButton_Click" Tag="文件夹"/>
                <RadioButton Content="文件" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,7" Checked="FilterButton_Click" Tag="文件"/>
                <Button Content="＋ 添加收藏" Margin="8,0,7,7" Click="Add_Click" Style="{StaticResource PrimaryButton}"/>
                <Button Content="管理分组" Margin="0,0,7,7" Click="ManageGroups_Click"/>
                <Button Content="导入" Margin="0,0,7,7" Click="Import_Click"/>
                <Button Content="导出" Margin="0,0,7,7" Click="Export_Click"/>
            </WrapPanel>
        </StackPanel>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </Border>

        <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Margin="0,8,0,0">
            <Grid>
                <ListBox x:Name="ItemsList" Margin="20,6,14,6" BorderThickness="0" Background="Transparent"
                         VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="Open_Click">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <DockPanel Margin="3,8">
                                <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SoftBrush}"
                                        DockPanel.Dock="Left" Margin="0,0,12,0" ToolTip="{Binding IconError}">
                                    <Grid>
                                        <TextBlock Text="?" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}"/>
                                        <Image Source="{Binding Icon}" Width="22" Height="22"/>
                                    </Grid>
                                </Border>
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                    <Button Content="{Binding PinLabel}" Padding="9,6" Margin="0,0,6,0" Click="Pin_Click" Tag="{Binding}" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/>
                                    <Button Content="编辑" Padding="9,6" Margin="0,0,6,0" Click="Edit_Click" Tag="{Binding}" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/>
                                    <Button Content="移除" Padding="9,6" Click="Remove_Click" Tag="{Binding}" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/>
                                </StackPanel>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Bookmark.Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Margin="0,4,0,0" Foreground="{DynamicResource MutedBrush}"
                                               TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </DockPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
                <TextBlock x:Name="EmptyText" Text="没有匹配的收藏" HorizontalAlignment="Center" VerticalAlignment="Top"
                           Margin="0,40,0,0" FontSize="12" Foreground="{DynamicResource MutedBrush}" Visibility="Collapsed"/>
            </Grid>
        </Border>
    </DockPanel>
</local:CardWindowBase>
