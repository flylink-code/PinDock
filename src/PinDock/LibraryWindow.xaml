<local:CardWindowBase x:Class="PinDock.LibraryWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PinDock"
        Title="全部收藏" Tag="收藏留在这里，常用的固定到 Dock" UseLargeHeader="True"
        Width="812" Height="640"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
    <Window.Resources>
        <Style x:Key="PinActionStyle" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Padding" Value="11,6"/>
            <Setter Property="FontSize" Value="11"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="{DynamicResource MutedBrush}"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinnedOrCandidate}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource SoftBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource AccentBrush}"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <!-- 搜索与筛选 -->
        <Border DockPanel.Dock="Top" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,0,1" Padding="24,14,24,10">
            <StackPanel>
                <Grid>
                    <TextBox x:Name="SearchBox" TextChanged="Filter_Changed" AutomationProperties.Name="搜索全部收藏"/>
                    <TextBlock x:Name="SearchHint" Text="搜索名称、路径、收藏组或直接搜本机已安装应用…" IsHitTestVisible="False" FontSize="12"
                               VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" Margin="12,0,0,0">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Visibility" Value="Collapsed"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                        <Setter Property="Visibility" Value="Visible"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Grid>
                <WrapPanel Margin="0,12,0,0">
                    <RadioButton x:Name="FilterAll" Content="全部" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,6" Checked="FilterButton_Click" Tag="all"/>
                    <RadioButton x:Name="FilterApps" Content="应用" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,6" Checked="FilterButton_Click" Tag="应用"/>
                    <RadioButton x:Name="FilterFolders" Content="文件夹" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,6" Checked="FilterButton_Click" Tag="文件夹"/>
                    <RadioButton x:Name="FilterFiles" Content="文件" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,6" Checked="FilterButton_Click" Tag="文件"/>
                    <RadioButton x:Name="FilterInstalled" Content="本机应用" GroupName="Filter" Style="{StaticResource ChipToggle}" Margin="0,0,7,6" Checked="FilterButton_Click" Tag="installed"/>
                    <Button Content="＋ 添加收藏" Margin="2,0,7,6" Click="Add_Click"/>
                    <Button Content="＋ 添加文件夹" Margin="0,0,7,6" Click="AddFolder_Click"/>
                    <Button Content="管理分组" Margin="0,0,7,6" Click="ManageGroups_Click"/>
                </WrapPanel>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Bottom" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <TextBlock x:Name="CountText" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
        </Border>

        <Grid>
            <ListBox x:Name="ItemsList" Margin="20,4,14,4" BorderThickness="0" Background="Transparent"
                     VirtualizingPanel.IsVirtualizing="True" MouseDoubleClick="Open_Click">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="3,8" Background="Transparent" Tag="{Binding}" MouseRightButtonUp="Row_RightClick">
                            <Border Width="34" Height="34" CornerRadius="8" Background="{DynamicResource SoftBrush}"
                                    DockPanel.Dock="Left" Margin="0,0,12,0" ToolTip="{Binding IconError}">
                                <Grid>
                                    <TextBlock Text="{Binding FallbackGlyph}" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                                               Foreground="{DynamicResource AccentBrush}"/>
                                    <Image Source="{Binding Icon}" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality"/>
                                </Grid>
                            </Border>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                                <Button Content="{Binding PinLabel}" Style="{StaticResource PinActionStyle}" Margin="0,0,4,0" Click="Pin_Click" Tag="{Binding}"/>
                                <Button Content="编辑" Padding="8,6" Margin="0,0,2,0" Click="Edit_Click" Tag="{Binding}"
                                        Visibility="{Binding SavedActionsVisibility}" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/>
                                <Button Content="移除" Padding="8,6" Click="Remove_Click" Tag="{Binding}"
                                        Visibility="{Binding SavedActionsVisibility}" Background="Transparent" Foreground="{DynamicResource MutedBrush}"/>
                            </StackPanel>
                            <Button Click="RowOpen_Click" Tag="{Binding}" Background="Transparent" BorderThickness="0" Padding="3,2"
                                    HorizontalContentAlignment="Stretch" VerticalContentAlignment="Center"
                                    ToolTipService.InitialShowDelay="160" ToolTipService.BetweenShowDelay="80" ToolTipService.ShowDuration="15000">
                                <Button.ToolTip>
                                    <ToolTip>
                                        <StackPanel MaxWidth="380">
                                            <TextBlock Text="{Binding Bookmark.Name}" FontSize="12" FontWeight="SemiBold" Foreground="White" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Subtitle}" FontSize="10.5" Foreground="#CCFFFFFF" Margin="0,3,0,0" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </ToolTip>
                                </Button.ToolTip>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Bookmark.Name}" FontSize="13" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" TextTrimming="CharacterEllipsis"/>
                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" FontFamily="Consolas, Microsoft YaHei UI" Margin="0,4,0,0"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>
                            </Button>
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel x:Name="EmptyPanel" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed">
                <TextBlock x:Name="EmptyText" Text="还没有收藏项，可点击上方「＋ 添加文件夹」或切换到「本机应用」一键固定常用软件"
                           TextAlignment="Center" FontSize="12" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </Grid>
    </DockPanel>
</local:CardWindowBase>
