<local:CardWindowBase x:Class="PinDock.BookmarkEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PinDock"
        Title="编辑收藏" Width="520" Height="640" WindowStartupLocation="CenterOwner">
    <Grid Margin="24,20,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <TextBlock Text="显示名称" FontSize="12" Foreground="{DynamicResource InkBrush}"/>
                <TextBox x:Name="NameInput" Margin="0,6,0,14"/>
                <TextBlock Text="目标路径" FontSize="12" Foreground="{DynamicResource InkBrush}"/>
                <TextBox x:Name="PathInput" Margin="0,6,0,14"/>
                <TextBlock Text="启动参数（仅程序）" FontSize="12" Foreground="{DynamicResource InkBrush}"/>
                <TextBox x:Name="ArgumentsInput" Margin="0,6,0,14"/>
                <TextBlock Text="工作目录（仅程序）" FontSize="12" Foreground="{DynamicResource InkBrush}"/>
                <TextBox x:Name="WorkingDirectoryInput" Margin="0,6,0,14"/>
                <TextBlock Text="收藏组" FontSize="12" Foreground="{DynamicResource InkBrush}"/>
                <ComboBox x:Name="GroupInput" Style="{StaticResource EditableComboBox}" Margin="0,6,0,16" HorizontalAlignment="Stretch"/>
                <CheckBox x:Name="PinnedInput" Content="同时固定到 Dock" Margin="0,0,0,14"/>
                <TextBlock Text="快捷方式直接打开，使用其原有配置。" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="保存" IsDefault="True" Padding="16,8" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</local:CardWindowBase>
