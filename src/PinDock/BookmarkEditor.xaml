<local:CardWindowBase x:Class="PinDock.BookmarkEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PinDock"
        Title="编辑收藏" Tag="支持搜索本机已安装应用，或直接选择文件夹与文件" UseLargeHeader="True"
        Width="560" Height="660" WindowStartupLocation="CenterOwner"
        AllowDrop="True" Drop="Window_Drop">
    <Grid Margin="24,18,24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <ScrollViewer VerticalScrollBarVisibility="Auto">
            <StackPanel>
                <Border x:Name="QuickAppSection" Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="14,12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="快速选择本机已安装应用" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="输入关键字筛选或下拉选择开始菜单/桌面应用，自动填入名称与路径" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="0,3,0,8"/>
                        <ComboBox x:Name="InstalledAppCombo" Style="{StaticResource EditableComboBox}"
                                  HorizontalAlignment="Stretch" SelectionChanged="InstalledAppCombo_SelectionChanged"/>
                    </StackPanel>
                </Border>
                <TextBlock Text="显示名称" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"/>
                <TextBox x:Name="NameInput" Margin="0,6,0,14"/>
                <DockPanel Margin="0,0,0,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <Button Content="选择文件夹…" Padding="10,4" FontSize="11" Margin="0,0,6,0" Click="BrowseFolder_Click"/>
                        <Button Content="选择应用 / 文件…" Padding="10,4" FontSize="11" Click="BrowseFile_Click"/>
                    </StackPanel>
                    <TextBlock Text="目标路径" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                </DockPanel>
                <TextBox x:Name="PathInput" Margin="0,0,0,14"/>
                <TextBlock Text="收藏组" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"/>
                <ComboBox x:Name="GroupInput" Style="{StaticResource EditableComboBox}" Margin="0,6,0,14" HorizontalAlignment="Stretch"/>
                <TextBlock Text="启动参数（仅 EXE 程序可选）" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"/>
                <TextBox x:Name="ArgumentsInput" Margin="0,6,0,14"/>
                <TextBlock Text="工作目录（仅 EXE 程序可选）" FontSize="12" FontWeight="Medium" Foreground="{DynamicResource InkBrush}"/>
                <TextBox x:Name="WorkingDirectoryInput" Margin="0,6,0,14"/>
                <CheckBox x:Name="PinnedInput" Content="同时固定到 Dock" Margin="0,2,0,12"/>
                <TextBlock Text="提示：也可直接把桌面图标、文件夹或文件拖入此窗口或 Dock 栏。" FontSize="11" Foreground="{DynamicResource MutedBrush}"/>
            </StackPanel>
        </ScrollViewer>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,14,0,0">
            <Button Content="取消" IsCancel="True" Padding="16,8" Margin="0,0,8,0"/>
            <Button Content="保存收藏" IsDefault="True" Padding="18,8" Click="Save_Click" Style="{StaticResource PrimaryButton}"/>
        </StackPanel>
    </Grid>
</local:CardWindowBase>
