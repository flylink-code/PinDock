<Window x:Class="PinDock.BookmarkEditor"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="编辑收藏" Width="480" Height="480" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource PaperBrush}">
    <Grid Margin="24">
        <Grid.RowDefinitions><RowDefinition/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Text="显示名称" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="NameInput" Margin="0,5,0,12" Padding="6"/>
            <TextBlock Text="目标路径" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="PathInput" Margin="0,5,0,12" Padding="6"/>
            <TextBlock Text="启动参数（仅程序）" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="ArgumentsInput" Margin="0,5,0,12" Padding="6"/>
            <TextBlock Text="工作目录（仅程序）" Foreground="{DynamicResource InkBrush}"/><TextBox x:Name="WorkingDirectoryInput" Margin="0,5,0,12" Padding="6"/>
            <TextBlock Text="收藏组" Foreground="{DynamicResource InkBrush}"/><ComboBox x:Name="GroupInput" Margin="0,5,0,12" IsEditable="True"/>
            <CheckBox x:Name="PinnedInput" Content="同时固定到 Dock" Margin="0,0,0,12"/>
            <TextBlock Text="快捷方式直接打开，使用其原有配置。" Foreground="{DynamicResource MutedBrush}"/>
        </StackPanel>
        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" IsCancel="True" Padding="14,7" Margin="0,0,8,0"/>
            <Button Content="保存" IsDefault="True" Padding="14,7" Click="Save_Click"/>
        </StackPanel>
    </Grid>
</Window>
