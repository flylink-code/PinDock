<Window x:Class="PinDock.GroupPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收藏组" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Border Width="330" MaxHeight="420" Background="{DynamicResource GlassBrush}" BorderBrush="#B0FFFFFF"
            BorderThickness="1" CornerRadius="15" Padding="18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="10" Opacity="0.2" Color="#294637"/>
        </Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock x:Name="CountText" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
            </DockPanel>
            <TextBox x:Name="SearchBox" DockPanel.Dock="Top" Margin="0,0,0,8" Padding="9,8" FontSize="12"
                     Background="#55FFFFFF" BorderBrush="{DynamicResource LineBrush}" TextChanged="SearchBox_TextChanged"/>
            <TextBlock DockPanel.Dock="Bottom" Margin="0,8,0,0" FontSize="10" Foreground="{DynamicResource MutedBrush}"
                       Text="收藏组 ≠ 文件夹目录 · 不扫描磁盘内容"/>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
