<Window x:Class="PinDock.GroupPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="收藏组" WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" ResizeMode="NoResize" SizeToContent="WidthAndHeight" Topmost="True"
        PreviewKeyDown="Window_PreviewKeyDown" Deactivated="Window_Deactivated">
    <Border Width="330" MaxHeight="420" Background="{DynamicResource GlassBrush}" BorderBrush="{DynamicResource GlassBorderBrush}"
            BorderThickness="1" CornerRadius="15" Padding="18" SnapsToDevicePixels="True">
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,12">
                <TextBlock x:Name="TitleText" FontWeight="SemiBold" FontSize="14" Foreground="{DynamicResource InkBrush}"/>
                <TextBlock x:Name="CountText" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
            </DockPanel>
            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                <TextBox x:Name="SearchBox" Padding="10,7" FontSize="12"
                         Background="{DynamicResource InputBackgroundBrush}" BorderBrush="{DynamicResource LineBrush}" TextChanged="SearchBox_TextChanged"/>
                <TextBlock Text="搜索本组收藏…" IsHitTestVisible="False" FontSize="12" VerticalAlignment="Center"
                           Foreground="{DynamicResource MutedBrush}" Margin="13,0,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
            <Border DockPanel.Dock="Bottom" Margin="0,8,0,0" Padding="0,11,0,0" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0">
                <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}" Text="收藏组 ≠ 文件夹目录 · 不扫描磁盘内容"/>
            </Border>
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel x:Name="ListPanel"/>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
