<Window x:Class="PinDock.WebPanelWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
        Title="PinDock" Width="812" Height="620" MinWidth="680" MinHeight="480"
        WindowStyle="None" ResizeMode="NoResize"
        Background="{DynamicResource PaperBrush}"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="Window_Drop">
    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="{DynamicResource PaperBrush}" SnapsToDevicePixels="True">
        <wv2:WebView2 x:Name="Browser" DefaultBackgroundColor="Transparent"/>
    </Border>
</Window>
