<Window x:Class="PinDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="PinDock 设置" Width="740" Height="520" MinWidth="640" MinHeight="420"
        Background="{DynamicResource PaperBrush}" WindowStartupLocation="CenterScreen">
    <DockPanel>
        <DockPanel DockPanel.Dock="Top" Height="57" Margin="22,0">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="PinDock 设置" FontSize="13" Foreground="{DynamicResource InkBrush}" VerticalAlignment="Center"/>
                <TextBlock Text="让它适合你的习惯" FontSize="11" Foreground="{DynamicResource MutedBrush}" Margin="10,0,0,0" VerticalAlignment="Center"/>
            </StackPanel>
            <Button Content="×" Width="36" Height="36" FontSize="20" HorizontalAlignment="Right" VerticalAlignment="Center"
                    Background="Transparent" BorderThickness="0" Foreground="{DynamicResource MutedBrush}" Click="Close_Click"/>
        </DockPanel>
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="158"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Margin="12,16" Background="Transparent">
                <Button x:Name="NavGeneral" Content="常规" Margin="0,0,0,5" Padding="11" HorizontalContentAlignment="Left" Click="Nav_Click" Tag="general"/>
                <Button x:Name="NavAppearance" Content="外观" Margin="0,0,0,5" Padding="11" HorizontalContentAlignment="Left" Click="Nav_Click" Tag="appearance"/>
                <Button x:Name="NavBehavior" Content="位置与行为" Margin="0,0,0,5" Padding="11" HorizontalContentAlignment="Left" Click="Nav_Click" Tag="behavior"/>
                <Button x:Name="NavAbout" Content="数据与关于" Margin="0,0,0,5" Padding="11" HorizontalContentAlignment="Left" Click="Nav_Click" Tag="about"/>
            </StackPanel>
            <ScrollViewer Grid.Column="1" Margin="8,8,22,16" VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <StackPanel x:Name="PanelGeneral">
                        <TextBlock Text="按你的节奏出现" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="常驻手边，或需要时再呼出。原生任务栏始终保留。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                        <TextBlock Text="显示模式" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <RadioButton x:Name="ModePersistent" Content="常驻显示" GroupName="Mode" Margin="0,0,0,8" Checked="SettingsChanged"/>
                        <RadioButton x:Name="ModeHotkey" Content="快捷键呼出" GroupName="Mode" Margin="0,0,0,8" Checked="SettingsChanged"/>
                        <RadioButton x:Name="ModeAutoHide" Content="贴边自动隐藏" GroupName="Mode" Margin="0,0,0,16" Checked="SettingsChanged"/>
                        <TextBlock Text="显示 / 隐藏快捷键：Alt + Shift + P" Margin="0,0,0,12" Foreground="{DynamicResource MutedBrush}"/>
                        <CheckBox x:Name="CollapseAfterLaunch" Content="启动收藏项后收起（快捷键呼出 / 自动隐藏）" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                    </StackPanel>
                    <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                        <TextBlock Text="安静，也有自己的样子" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="少一点装饰，多一点清晰。修改后可直接观察 Dock。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                        <TextBlock Text="配色方案" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <RadioButton x:Name="PaletteForest" Content="苔原绿" GroupName="Palette" Margin="0,0,12,8" Checked="SettingsChanged"/>
                            <RadioButton x:Name="PaletteOcean" Content="海盐蓝" GroupName="Palette" Margin="0,0,12,8" Checked="SettingsChanged"/>
                            <RadioButton x:Name="PaletteSand" Content="暖砂" GroupName="Palette" Margin="0,0,12,8" Checked="SettingsChanged"/>
                            <RadioButton x:Name="PaletteClay" Content="陶土" GroupName="Palette" Margin="0,0,12,8" Checked="SettingsChanged"/>
                            <RadioButton x:Name="PaletteGraphite" Content="石墨" GroupName="Palette" Margin="0,0,12,8" Checked="SettingsChanged"/>
                        </WrapPanel>
                        <DockPanel Margin="0,8,0,12">
                            <TextBlock Text="主题" VerticalAlignment="Center"/>
                            <ComboBox x:Name="ThemeBox" Width="160" HorizontalAlignment="Right" SelectionChanged="SettingsChanged">
                                <ComboBoxItem Content="浅色" Tag="Light"/>
                                <ComboBoxItem Content="深色" Tag="Dark"/>
                                <ComboBoxItem Content="跟随系统" Tag="System"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel Margin="0,0,0,12">
                            <TextBlock Text="图标大小" VerticalAlignment="Center"/>
                            <ComboBox x:Name="SizeBox" Width="160" HorizontalAlignment="Right" SelectionChanged="SettingsChanged">
                                <ComboBoxItem Content="紧凑" Tag="Compact"/>
                                <ComboBoxItem Content="标准" Tag="Standard"/>
                                <ComboBoxItem Content="宽松" Tag="Comfortable"/>
                            </ComboBox>
                        </DockPanel>
                        <DockPanel>
                            <TextBlock x:Name="OpacityLabel" Text="透明度 94%" VerticalAlignment="Center"/>
                            <Slider x:Name="OpacitySlider" Minimum="40" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Width="220" HorizontalAlignment="Right" ValueChanged="Opacity_Changed"/>
                        </DockPanel>
                    </StackPanel>
                    <StackPanel x:Name="PanelBehavior" Visibility="Collapsed">
                        <TextBlock Text="共存，而不是接管" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="不替换任务栏，不占用桌面工作区。" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18" TextWrapping="Wrap"/>
                        <CheckBox x:Name="TopmostBox" Content="保持在普通窗口上方" Margin="0,0,0,10" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="AvoidFullscreenBox" Content="全屏应用时自动避让" Margin="0,0,0,10" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <CheckBox x:Name="LockPositionBox" Content="锁定 Dock 位置" Margin="0,0,0,16" Checked="SettingsChanged" Unchecked="SettingsChanged"/>
                        <TextBlock Text="停靠位置" FontWeight="SemiBold" Margin="0,0,0,10"/>
                        <WrapPanel>
                            <RadioButton x:Name="EdgeTop" Content="顶部" GroupName="Edge" Margin="0,0,12,8" Checked="SettingsChanged"/>
                            <RadioButton x:Name="EdgeLeft" Content="左侧" GroupName="Edge" Margin="0,0,12,8" Checked="SettingsChanged"/>
                            <RadioButton x:Name="EdgeRight" Content="右侧" GroupName="Edge" Margin="0,0,12,8" Checked="SettingsChanged"/>
                            <RadioButton x:Name="EdgeBottom" Content="底部" GroupName="Edge" Margin="0,0,12,8" Checked="SettingsChanged"/>
                        </WrapPanel>
                        <TextBlock Text="显示器策略" FontWeight="SemiBold" Margin="0,12,0,10"/>
                        <ComboBox x:Name="MonitorPolicyBox" SelectionChanged="SettingsChanged" Margin="0,0,0,8">
                            <ComboBoxItem Content="固定到指定显示器" Tag="Fixed"/>
                            <ComboBoxItem Content="跟随系统主显示器" Tag="Primary"/>
                            <ComboBoxItem Content="呼出时跟随鼠标" Tag="FollowCursor"/>
                        </ComboBox>
                        <ComboBox x:Name="MonitorBox" SelectionChanged="SettingsChanged" Margin="0,0,0,12"/>
                        <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="15" Margin="0,8,0,0">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Foreground="{DynamicResource InkBrush}"
                                       Text="贴边自动隐藏：若停靠边与另一块显示器相邻，鼠标可能穿过边界而无法触发展开。建议改停靠到不相邻的边。"/>
                        </Border>
                    </StackPanel>
                    <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                        <TextBlock Text="你的收藏，留在本地" FontSize="21" FontWeight="SemiBold" Foreground="{DynamicResource InkBrush}"/>
                        <TextBlock Text="PinDock · Windows 独立悬浮启动栏" FontSize="12" Foreground="{DynamicResource MutedBrush}" Margin="0,6,0,18"/>
                        <Border Background="{DynamicResource SoftBrush}" CornerRadius="9" Padding="15" Margin="0,0,0,16">
                            <TextBlock TextWrapping="Wrap" FontSize="12" Text="收藏保存在 %LocalAppData%\PinDock\library.json。导入 / 导出不会删除目标文件。"/>
                        </Border>
                        <Button Content="导入收藏" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left" Click="Import_Click"/>
                        <Button Content="导出收藏" Padding="12,8" Margin="0,0,0,8" HorizontalAlignment="Left" Click="Export_Click"/>
                        <TextBlock Text="技术方案：C# + WPF · 开源协议：MIT" Margin="0,16,0,0" Foreground="{DynamicResource MutedBrush}"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
