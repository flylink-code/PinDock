<local:CardWindowBase x:Class="PinDock.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:PinDock"
        Title="PinDock 设置" Tag="让它适合你的习惯" Width="772" Height="560" MinWidth="680" MinHeight="480"
        WindowStartupLocation="CenterScreen"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="158"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- 侧栏 -->
        <Border Grid.RowSpan="1" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0" Padding="12,23">
            <DockPanel>
                <TextBlock DockPanel.Dock="Bottom" FontFamily="Consolas" FontSize="10" LineHeight="18"
                           Foreground="{DynamicResource MutedBrush}" Margin="12,30,0,0">
                    LESS FRICTION.<LineBreak/>MORE FOCUS.<LineBreak/><LineBreak/>PinDock / Concept 01
                </TextBlock>
                <StackPanel>
                    <RadioButton x:Name="NavGeneral" Content="常规" Style="{StaticResource NavItem}" GroupName="Nav" IsChecked="True" Checked="Nav_Checked" Tag="general"/>
                    <RadioButton x:Name="NavAppearance" Content="外观" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked" Tag="appearance"/>
                    <RadioButton x:Name="NavBehavior" Content="位置与行为" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked" Tag="behavior"/>
                    <RadioButton x:Name="NavAbout" Content="数据与关于" Style="{StaticResource NavItem}" GroupName="Nav" Checked="Nav_Checked" Tag="about"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 内容 -->
        <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" Padding="28,26,22,26">
            <Grid>
                <!-- 常规 -->
                <StackPanel x:Name="PanelGeneral">
                    <TextBlock Text="按你的节奏出现" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="常驻手边，或需要时再呼出。原生任务栏始终保留。" Style="{StaticResource PageSubtitle}"/>
                    <TextBlock Text="显示模式" Style="{StaticResource SectionLabel}"/>
                    <RadioButton x:Name="ModePersistent" GroupName="Mode" Style="{StaticResource ModeCard}" Checked="SettingsChanged">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}" Margin="12,0,0,0">
                                <TextBlock Text="默认" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <StackPanel>
                                <TextBlock Text="常驻显示" FontSize="13" FontWeight="SemiBold"/>
                                <TextBlock Text="始终在手边，快捷键可临时收起" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeHotkey" GroupName="Mode" Style="{StaticResource ModeCard}" Checked="SettingsChanged">
                        <StackPanel>
                            <TextBlock Text="快捷键呼出" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="需要时出现，完成后安静退场" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="ModeAutoHide" GroupName="Mode" Style="{StaticResource ModeCard}" Checked="SettingsChanged">
                        <StackPanel>
                            <TextBlock Text="贴边自动隐藏" FontSize="13" FontWeight="SemiBold"/>
                            <TextBlock Text="鼠标靠近屏幕边缘时展开" Style="{StaticResource RowHint}"/>
                        </StackPanel>
                    </RadioButton>
                    <Border Style="{StaticResource Row}" Margin="0,8,0,0">
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                <Button x:Name="HotkeyCaptureButton" Click="HotkeyCapture_Click" Padding="11,6" Margin="0,0,6,0"
                                        ToolTip="点击后直接按下新的组合键（如 Ctrl+Alt+P）">
                                    <TextBlock x:Name="HotkeyText" Text="Alt + Shift + P" FontFamily="Consolas, Microsoft YaHei UI" FontSize="11"/>
                                </Button>
                                <Button x:Name="ClearHotkeyButton" Content="清除" Padding="10,6" Margin="0,0,6,0"
                                        Click="ClearHotkey_Click" ToolTip="清除快捷键，不使用全局热键"/>
                                <Button x:Name="ResetHotkeyButton" Content="默认" Padding="10,6"
                                        Click="ResetHotkey_Click" ToolTip="恢复默认 Alt + Shift + P"/>
                            </StackPanel>
                            <StackPanel>
                                <TextBlock Text="显示 / 隐藏快捷键" Style="{StaticResource RowTitle}"/>
                                <TextBlock x:Name="HotkeyHintText" Text="点击快捷键可重新录制，或点击“清除”设为不使用" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox x:Name="CollapseAfterLaunch" DockPanel.Dock="Right" Style="{StaticResource Switch}"
                                      Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="启动收藏项后收起"/>
                            <StackPanel>
                                <TextBlock Text="启动收藏项后收起" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="仅在快捷键呼出与贴边自动隐藏模式下生效" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                </StackPanel>

                <!-- 外观 -->
                <StackPanel x:Name="PanelAppearance" Visibility="Collapsed">
                    <TextBlock Text="安静，也有自己的样子" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="少一点装饰，多一点清晰。修改后可直接观察 Dock。" Style="{StaticResource PageSubtitle}"/>
                    <TextBlock Text="配色方案 · 可搭配浅色 / 深色" Style="{StaticResource SectionLabel}"/>
                    <WrapPanel>
                        <RadioButton x:Name="PaletteForest" Content="苔原绿" GroupName="Palette" Style="{StaticResource Swatch}" Background="#527649" Checked="SettingsChanged"/>
                        <RadioButton x:Name="PaletteOcean" Content="海盐蓝" GroupName="Palette" Style="{StaticResource Swatch}" Background="#568DAD" Checked="SettingsChanged"/>
                        <RadioButton x:Name="PaletteSand" Content="暖砂" GroupName="Palette" Style="{StaticResource Swatch}" Background="#B5925E" Checked="SettingsChanged"/>
                        <RadioButton x:Name="PaletteClay" Content="陶土" GroupName="Palette" Style="{StaticResource Swatch}" Background="#BC7A60" Checked="SettingsChanged"/>
                        <RadioButton x:Name="PaletteGraphite" Content="石墨" GroupName="Palette" Style="{StaticResource Swatch}" Background="#6B7A86" Checked="SettingsChanged"/>
                    </WrapPanel>
                    <Border Style="{StaticResource Row}" Margin="0,8,0,0">
                        <DockPanel>
                            <ComboBox x:Name="ThemeBox" DockPanel.Dock="Right" SelectionChanged="SettingsChanged" AutomationProperties.Name="主题">
                                <ComboBoxItem Content="浅色" Tag="Light"/>
                                <ComboBoxItem Content="深色" Tag="Dark"/>
                                <ComboBoxItem Content="跟随系统" Tag="System"/>
                            </ComboBox>
                            <TextBlock Text="主题" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <ComboBox x:Name="SizeBox" DockPanel.Dock="Right" SelectionChanged="SettingsChanged" AutomationProperties.Name="图标大小">
                                <ComboBoxItem Content="紧凑" Tag="Compact"/>
                                <ComboBoxItem Content="标准" Tag="Standard"/>
                                <ComboBoxItem Content="宽松" Tag="Comfortable"/>
                            </ComboBox>
                            <TextBlock Text="图标大小" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBlock x:Name="OpacityValue" DockPanel.Dock="Right" Width="40" TextAlignment="Right" FontFamily="Consolas"
                                       FontSize="11" Foreground="{DynamicResource MutedBrush}" VerticalAlignment="Center" Text="94%"/>
                            <Slider x:Name="OpacitySlider" DockPanel.Dock="Right" Width="180" Minimum="40" Maximum="100" TickFrequency="5"
                                    IsSnapToTickEnabled="True" ValueChanged="Opacity_Changed" VerticalAlignment="Center"
                                    AutomationProperties.Name="透明度"/>
                            <StackPanel>
                                <TextBlock Text="透明度" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="作用于 Dock 与收藏组弹层，最低 40%" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Border DockPanel.Dock="Right" Style="{StaticResource Badge}">
                                <TextBlock Text="默认开启" FontSize="9" Foreground="{DynamicResource MutedBrush}"/>
                            </Border>
                            <TextBlock Text="悬停名称提示" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Notice}">
                        <TextBlock Text="图标优先提取应用与文件夹的系统图标；提取不到时显示占位。" FontSize="12" LineHeight="22"
                                   TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"/>
                    </Border>
                </StackPanel>

                <!-- 位置与行为 -->
                <StackPanel x:Name="PanelBehavior" Visibility="Collapsed">
                    <TextBlock Text="共存，而不是接管" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="不替换任务栏，不占用桌面工作区。" Style="{StaticResource PageSubtitle}"/>
                    <TextBlock Text="显示器" Style="{StaticResource SectionLabel}"/>
                    <ComboBox x:Name="MonitorPolicyBox" HorizontalAlignment="Left" MinWidth="210" SelectionChanged="SettingsChanged" AutomationProperties.Name="显示器策略">
                        <ComboBoxItem Content="固定到指定显示器" Tag="Fixed"/>
                        <ComboBoxItem Content="跟随系统主显示器" Tag="Primary"/>
                        <ComboBoxItem Content="呼出时跟随鼠标" Tag="FollowCursor"/>
                    </ComboBox>
                    <ItemsControl x:Name="MonitorList" Margin="0,14,0,0">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><UniformGrid Rows="1"/></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <TextBlock x:Name="MonitorHint" Style="{StaticResource RowHint}" Margin="0,10,0,6"/>
                    <Border Style="{StaticResource Row}" Margin="0,8,0,0">
                        <DockPanel>
                            <CheckBox x:Name="TopmostBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="保持在普通窗口上方"/>
                            <TextBlock Text="保持在普通窗口上方" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox x:Name="AvoidFullscreenBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="全屏应用时自动避让"/>
                            <TextBlock Text="全屏应用时自动避让" Style="{StaticResource RowTitle}" VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox x:Name="LockPositionBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="SettingsChanged" Unchecked="SettingsChanged" AutomationProperties.Name="锁定 Dock 位置"/>
                            <StackPanel>
                                <TextBlock Text="锁定 Dock 位置" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="未锁定时可沿停靠边拖动 Dock" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <CheckBox x:Name="ExplorerMenuBox" DockPanel.Dock="Right" Style="{StaticResource Switch}" Checked="ExplorerMenu_Changed" Unchecked="ExplorerMenu_Changed" AutomationProperties.Name="集成到资源管理器文件夹右键菜单"/>
                            <StackPanel>
                                <TextBlock Text="资源管理器右键添加文件夹" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="在系统文件夹上右键可直接选择“添加到 PinDock”并固定" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <TextBlock Text="停靠位置" Style="{StaticResource SectionLabel}" Margin="0,18,0,10"/>
                    <Border BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="12" Padding="12"
                            Width="310" HorizontalAlignment="Center">
                        <Grid Height="140">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="62"/><ColumnDefinition Width="*"/><ColumnDefinition Width="62"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="35"/><RowDefinition Height="*"/><RowDefinition Height="35"/>
                            </Grid.RowDefinitions>
                            <Border Grid.Column="1" Grid.Row="1" Margin="7" BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" CornerRadius="5">
                                <TextBlock x:Name="ScreenLabel" Text="主显示器" FontSize="11" Foreground="{DynamicResource MutedBrush}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <RadioButton x:Name="EdgeTop" Grid.Column="1" Content="顶部" GroupName="Edge" Style="{StaticResource ChipToggle}" Margin="7,0" Checked="SettingsChanged"/>
                            <RadioButton x:Name="EdgeLeft" Grid.Row="1" Content="左侧" GroupName="Edge" Style="{StaticResource ChipToggle}" Margin="0,7" Checked="SettingsChanged"/>
                            <RadioButton x:Name="EdgeRight" Grid.Column="2" Grid.Row="1" Content="右侧" GroupName="Edge" Style="{StaticResource ChipToggle}" Margin="0,7" Checked="SettingsChanged"/>
                            <RadioButton x:Name="EdgeBottom" Grid.Column="1" Grid.Row="2" Content="底部" GroupName="Edge" Style="{StaticResource ChipToggle}" Margin="7,0" Checked="SettingsChanged"/>
                        </Grid>
                    </Border>
                    <Border Style="{StaticResource Notice}">
                        <TextBlock FontSize="12" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"
                                   Text="贴边自动隐藏：若停靠边与另一块显示器相邻，鼠标可能穿过边界而无法触发展开，建议改停靠到不相邻的边。"/>
                    </Border>
                </StackPanel>

                <!-- 数据与关于 -->
                <StackPanel x:Name="PanelAbout" Visibility="Collapsed">
                    <TextBlock Text="你的收藏，留在本地" Style="{StaticResource PageTitle}"/>
                    <TextBlock Text="PinDock · Windows 独立悬浮启动栏" Style="{StaticResource PageSubtitle}"/>
                    <Border Style="{StaticResource Notice}" Margin="0,0,0,8">
                        <TextBlock FontSize="12" LineHeight="22" TextWrapping="Wrap" Foreground="{DynamicResource InkBrush}"
                                   Text="收藏与设置保存在 %LocalAppData%\PinDock\library.json，不联网、不上传。移除收藏不会删除目标文件。"/>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Button Content="导入…" DockPanel.Dock="Right" Click="Import_Click"/>
                            <StackPanel>
                                <TextBlock Text="导入收藏" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="按目标与启动配置去重，已存在的会被跳过" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <Button Content="导出…" DockPanel.Dock="Right" Click="Export_Click"/>
                            <StackPanel>
                                <TextBlock Text="导出收藏" Style="{StaticResource RowTitle}"/>
                                <TextBlock Text="生成可备份、可迁移的 JSON 文件" Style="{StaticResource RowHint}"/>
                            </StackPanel>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBlock Text="C# + WPF" DockPanel.Dock="Right" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="技术方案" Style="{StaticResource RowTitle}"/>
                        </DockPanel>
                    </Border>
                    <Border Style="{StaticResource Row}">
                        <DockPanel>
                            <TextBlock Text="MIT" DockPanel.Dock="Right" Style="{StaticResource RowTitle}"/>
                            <TextBlock Text="开源协议" Style="{StaticResource RowTitle}"/>
                        </DockPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <!-- 页脚 -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,1,0,0" Padding="22,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="修改即时生效并自动保存" FontSize="10" Foreground="{DynamicResource MutedBrush}"/>
                <TextBlock FontSize="10" Foreground="{DynamicResource MutedBrush}">
                    <Run Text="●" Foreground="#609372"/> 仅保存在本机
                </TextBlock>
            </DockPanel>
        </Border>
    </Grid>
</local:CardWindowBase>
